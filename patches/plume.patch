+extern "C" VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL vk_icdGetInstanceProcAddr(VkInstance instance, const char *name);
+#endif
+
 #include <algorithm>
 #include <cmath>
 #include <climits>
@@ -58,6 +63,8 @@ namespace plume {
 #   endif
 #   elif defined(__APPLE__)
         VK_EXT_METAL_SURFACE_EXTENSION_NAME,
+#   elif defined(__PROSPERO__)
+        VK_KHR_DISPLAY_EXTENSION_NAME,
 #   endif
     };
 
@@ -2095,6 +2102,40 @@ namespace plume {
             fprintf(stderr, "vkCreateWin32SurfaceKHR failed with error code 0x%X.\n", res);
             return;
         }
+#   elif defined(__PROSPERO__)
+        // The display's first mode is the output the system set (3840x2160 at 59.94 Hz on the
+        // tested console); a display plane surface has to use the mode's own extent.
+        VulkanInterface *renderInterface = commandQueue->device->renderInterface;
+        VkPhysicalDevice displayDevice = commandQueue->device->physicalDevice;
+        VkDisplayPropertiesKHR displayProperties = {};
+        uint32_t displayCount = 1;
+        res = vkGetPhysicalDeviceDisplayPropertiesKHR(displayDevice, &displayCount, &displayProperties);
+        if (((res != VK_SUCCESS) && (res != VK_INCOMPLETE)) || (displayCount == 0)) {
+            fprintf(stderr, "vkGetPhysicalDeviceDisplayPropertiesKHR failed with error code 0x%X.\n", res);
+            return;
+        }
+
+        uint32_t modeCount = 0;
+        vkGetDisplayModePropertiesKHR(displayDevice, displayProperties.display, &modeCount, nullptr);
+        std::vector<VkDisplayModePropertiesKHR> modes(modeCount);
+        res = vkGetDisplayModePropertiesKHR(displayDevice, displayProperties.display, &modeCount, modes.data());
+        if ((res != VK_SUCCESS) || (modeCount == 0)) {
+            fprintf(stderr, "vkGetDisplayModePropertiesKHR failed with error code 0x%X.\n", res);
+            return;
+        }
+
+        displayExtent = modes[0].parameters.visibleRegion;
+        VkDisplaySurfaceCreateInfoKHR surfaceCreateInfo = {};
+        surfaceCreateInfo.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+        surfaceCreateInfo.displayMode = modes[0].displayMode;
+        surfaceCreateInfo.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+        surfaceCreateInfo.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+        surfaceCreateInfo.imageExtent = displayExtent;
+        res = vkCreateDisplayPlaneSurfaceKHR(renderInterface->instance, &surfaceCreateInfo, nullptr, &surface);
+        if (res != VK_SUCCESS) {
+            fprintf(stderr, "vkCreateDisplayPlaneSurfaceKHR failed with error code 0x%X.\n", res);
+            return;
+        }
 #   elif defined(PLUME_SDL_VULKAN_ENABLED)
         VulkanInterface *renderInterface = commandQueue->device->renderInterface;
         SDL_bool sdlRes = SDL_Vulkan_CreateSurface(desc.renderWindow, renderInterface->instance, &surface);
@@ -2463,6 +2504,9 @@ namespace plume {
         GetClientRect(desc.renderWindow, &rect);
         dstWidth = rect.right - rect.left;
         dstHeight = rect.bottom - rect.top;
+#   elif defined(__PROSPERO__)
+        dstWidth = displayExtent.width;
+        dstHeight = displayExtent.height;
 #   elif defined(PLUME_SDL_VULKAN_ENABLED)
         SDL_GetWindowSizeInPixels(desc.renderWindow, (int *)(&dstWidth), (int *)(&dstHeight));
 #   elif defined(__ANDROID__)
