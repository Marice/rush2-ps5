diff --git a/librecomp/src/recomp.cpp b/librecomp/src/recomp.cpp
index e3086d9..eac8362 100644
--- a/librecomp/src/recomp.cpp
+++ b/librecomp/src/recomp.cpp
@@ -30,6 +30,9 @@
 #    include <Windows.h>
 #else
 #    include <sys/mman.h>
+#    if defined(__PROSPERO__)
+#        include <ps5platform/kernel.h>
+#    endif
 #endif
 
 #if defined(_WIN32)
@@ -864,6 +867,58 @@ void recomp::start(
             VirtualFree(rdram, 0, MEM_RELEASE);
         }
     }
+#elif defined(__PROSPERO__)
+    // A title's anonymous memory budget (448 MiB) cannot hold rdram, and an anonymous PROT_NONE
+    // reservation of 1 GiB or more fails. Reserve the address space with the kernel instead and back
+    // the first mem_size bytes with direct memory at its start; the rest stays without access.
+    // The reservation goes at a fixed address: where the kernel puts mappings it is given no address
+    // for is the 4 GiB window RADV needs for its GPU ring (radv_ps5_platform.c), and a 4 GiB
+    // reservation there left RADV without one (no Vulkan device). The candidates avoid that window
+    // (0x200000000-0x2FFFFFFFF) and RADV's device-memory region (256 GiB at 0x4000000000); the first
+    // the kernel accepts is used (0x300000000 on the tested console).
+    static constexpr uintptr_t rdram_candidates[] = {
+        0x0300000000, 0x0400000000, 0x0800000000, 0x1000000000, 0x2000000000,
+        0x8000000000, 0x10000000000, 0x40000000000,
+    };
+    int64_t rdram_direct = 0;
+    void* rdram_base = nullptr;
+    alloc_failed = true;
+    for (uintptr_t candidate : rdram_candidates) {
+        void* at = reinterpret_cast<void*>(candidate);
+        int32_t res = sceKernelReserveVirtualRange(&at, allocation_size, 0, PS5_KERNEL_DIRECT_ALIGNMENT);
+        if (res != 0) {
+            continue;
+        }
+        if (at != reinterpret_cast<void*>(candidate)) {
+            sceKernelMunmap(at, allocation_size);
+            continue;
+        }
+        rdram_base = at;
+        alloc_failed = false;
+        break;
+    }
+    if (!alloc_failed) {
+        int32_t res = sceKernelAllocateDirectMemory(0, sceKernelGetDirectMemorySize(), mem_size,
+            PS5_KERNEL_DIRECT_ALIGNMENT, PS5_KERNEL_DIRECT_TYPE_CPU, &rdram_direct);
+        alloc_failed = res != 0;
+        if (!alloc_failed) {
+            void* mapped = rdram_base;
+            res = sceKernelMapDirectMemory(&mapped, mem_size, PS5_KERNEL_PROT_CPU_READ | PS5_KERNEL_PROT_CPU_WRITE,
+                PS5_KERNEL_MAP_FIXED, rdram_direct, PS5_KERNEL_DIRECT_ALIGNMENT);
+            alloc_failed = res != 0 || mapped != rdram_base;
+            if (alloc_failed) {
+                sceKernelReleaseDirectMemory(rdram_direct, mem_size);
+            }
+        }
+        if (alloc_failed) {
+            sceKernelMunmap(rdram_base, allocation_size);
+        }
+    }
+    rdram = reinterpret_cast<uint8_t*>(rdram_base);
+    if (!alloc_failed) {
+        // Direct memory is not cleared on allocation; the runtime expects zeroed rdram.
+        memset(rdram, 0, mem_size);
+    }
 #else
     rdram = (uint8_t*)mmap(NULL, allocation_size, PROT_NONE, MAP_ANON | MAP_PRIVATE, -1, 0);
     alloc_failed = rdram == reinterpret_cast<uint8_t*>(MAP_FAILED);
@@ -917,6 +972,9 @@ void recomp::start(
 #ifdef _WIN32
     // VirtualFree returns zero on failure.
     free_failed = (VirtualFree(rdram, 0, MEM_RELEASE) == 0);
+#elif defined(__PROSPERO__)
+    free_failed = (sceKernelMunmap(rdram, allocation_size) != 0) ||
+        (sceKernelReleaseDirectMemory(rdram_direct, mem_size) != 0);
 #else
     // munmap returns -1 on failure.
     free_failed = (munmap(rdram, allocation_size) == -1);
