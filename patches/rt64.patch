+#   if defined(__PROSPERO__)
+        // On the PS5 a thread that compiled with RADV crashed when it ended: its thread-local
+        // destructors freed memory of the per-thread heap arena (mspace_free, address in RADV's
+        // region). The pipelines are compiled here, in order, so no such thread ends.
+        for (uint32_t i = 0; i < uint32_t(pipelineThreadCreations.size()); i++) {
+            threadCreatePipelines(i);
+        }
+#   else
         pipelineThreads.resize(pipelineThreadCreations.size());
         for (uint32_t i = 0; i < uint32_t(pipelineThreads.size()); i++) {
